# Copier vers .env puis adapter.
# Aucune base de données n'est nécessaire : cette version est une démo 100 % navigateur.
# DATABASE_URL n'est plus utilisé (plus de PostgreSQL ni de Prisma).

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optionnel — génération du rapport via un fournisseur IA côté serveur.
# Laisser NEXT_PUBLIC_DEMO_AI_SERVER=false pour utiliser le générateur local déterministe.
# NEXT_PUBLIC_DEMO_AI_SERVER=false
# AI_API_KEY=""
# La clé IA reste côté serveur : ne jamais la préfixer par NEXT_PUBLIC_ ni l'exposer au client.
